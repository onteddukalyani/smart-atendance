rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /attendance_sessions/{sessionId} {
      allow get: if request.auth != null
        && (resource.data.active == true || resource.data.ownerId == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /attendance_records/{recordId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == get(/databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)).data.ownerId
        && get(/databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)).data.active == true;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
